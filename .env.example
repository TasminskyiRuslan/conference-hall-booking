# Copy to .env (gitignored) to override defaults from docker-compose.yml
POSTGRES_DB=conference_booking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433
API_PORT=8080
# Development serves Swagger UI at /swagger; use Production for real deployments
ASPNETCORE_ENVIRONMENT=Development
# REQUIRED: docker compose refuses to start without it.
# Generate a key, e.g.: openssl rand -base64 48  (min 32 chars)
JWT_SECRET_KEY=
# Optional: when BOTH are set, an Admin user is seeded on `docker compose run --rm api --migrate`
ADMIN_EMAIL=
ADMIN_PASSWORD=
